# ── Оточення ───────────────────────────────────────────────
ENV_NAME=dev
BASE_URL=https://lms-exam-foreign-dev.raccoongang.com
# Якщо адмінка на іншому хості — інакше лишити порожнім (візьметься BASE_URL)
ADMIN_BASE_URL=
# Версія збірки для звіту (у CI підставляється автоматично)
BUILD_VERSION=

# ── Ролі (етап 2: модерація) ───────────────────────────────
# Порожньо = кейси модерації/допуску пропускаються, реєстрація працює
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Відповідальний за пункт тестування. Порожньо = використовується сесія адміністратора
PROCTOR_EMAIL=
PROCTOR_PASSWORD=
# storageState українського користувача, залогіненого через Дію вручну (див. README).
# Порожньо = кейси, яким потрібен UA-користувач, будуть skipped
UA_USER_STORAGE_STATE=

# ── Гео: як імітувати не-український IP ────────────────────
# proxy  — закордонний проксі/VPN (GEO_PROXY_*)
# header — тестовий заголовок-оверрайд, якщо бек dev-оточення його підтримує
# none   — раннер уже знаходиться за кордоном
# dev (lms-exam-foreign-dev) сам емулює закордонний IP → none
GEO_MODE=none
GEO_PROXY_SERVER=
GEO_PROXY_USERNAME=
GEO_PROXY_PASSWORD=
GEO_HEADER_NAME=X-Test-Country
GEO_HEADER_VALUE=CA

# ── Пошта ──────────────────────────────────────────────────
# maildrop — публічні скриньки maildrop.cc без реєстрації (за замовчуванням)
# mailpit  — власний mail-catcher оточення (MAIL_API_URL + TEST_EMAIL_DOMAIN)
MAIL_PROVIDER=maildrop
MAIL_API_URL=
TEST_EMAIL_DOMAIN=e2e.test

# ── Тестові дані на dev ────────────────────────────────────
EXAM_NAME=
# Пункт з увімкненою ознакою «Тільки для іноземних користувачів»
FOREIGN_TEST_CENTER_NAME=
# Звичайний пункт (ознака вимкнена)
REGULAR_TEST_CENTER_NAME=
# Окремий пункт, ознаку якого перемикає лише EXAM-03 (базовий стан — ознака ВИМКНЕНА)
TOGGLE_TEST_CENTER_NAME=

# ── Параметри з вимог ──────────────────────────────────────
OTP_TTL_SECONDS=600
# Паралельність реєстраційних тестів: dev віддає 403 на часті запити з одного IP
FOREIGN_WORKERS=2
MAX_UPLOAD_MB=10

# ── Звіт ───────────────────────────────────────────────────
TEST_PLAN_URL=
REPORT_OWNER=Vladyslav Bilobrov
# 1 = запускати й кейси з тегом @slow (напр. AUTH-05, чекає спливання коду)
INCLUDE_SLOW=

# ── QA Sphere ─────────────────────────────────────────────
# Код проєкту (з URL: https://rg.eu1.qasphere.com/project/<КОД>/...)
QAS_PROJECT=UKR
# Авторизація: $QASPHERE_API_KEY з ~/.zshrc (стандарт qa-base) підхоплюється автоматично;
# інакше `npm run qasphere:login` (OAuth) або розкоментуй токен:
# QAS_URL=https://rg.eu1.qasphere.com
# QAS_TOKEN=
# Необов'язково: посилання з кейсу на код тесту (напр. https://github.com/org/e2e-ukr-cert/blob/main)
REPO_URL=
