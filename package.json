{
  "name": "e2e-ukr-cert",
  "version": "0.1.0",
  "private": true,
  "description": "E2E-тести УкрСертифікації: реєстрація, авторизація та іспити для іноземних користувачів",
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:reg": "playwright test --project=foreign --grep \"REG-|INFRA-\"",
    "test:mod": "playwright test --project=foreign tests/journey.spec.ts tests/moderation.spec.ts",
    "test:qas": "QAS_REPORT=1 playwright test",
    "test:reg:qas": "QAS_REPORT=1 playwright test --project=foreign --grep \"REG-|INFRA-\"",
    "test:ui": "playwright test --ui",
    "test:headed": "SLOW_MO=400 playwright test --headed --workers=1",
    "test:reg:headed": "SLOW_MO=400 playwright test --headed --workers=1 --project=foreign --grep \"REG-|INFRA-\"",
    "test:foreign": "playwright test --project=foreign",
    "test:ua": "playwright test --project=ua",
    "test:slow": "INCLUDE_SLOW=1 playwright test --grep @slow",
    "test:list": "playwright test --list --reporter=list",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "report": "allure generate ./allure-results && allure open ./allure-report",
    "report:clean": "rm -rf allure-results allure-report test-results playwright-report",
    "report:gate": "allure quality-gate ./allure-results",
    "qasphere:login": "qasphere auth login",
    "qasphere:sync": "node scripts/qasphere-sync.mjs",
    "qasphere:export": "node scripts/qasphere-sync.mjs --export",
    "report:qasphere": "node scripts/qasphere-upload.mjs",
    "cleanup": "node scripts/cleanup.mjs",
    "docker:build": "docker compose build",
    "docker:test": "docker compose run --rm e2e --grep-invert @slow",
    "docker:reg": "docker compose run --rm e2e --project=foreign --grep \"REG-|INFRA-\"",
    "docker:smoke": "docker compose run --rm e2e --grep @smoke",
    "docker:ui": "docker compose --profile ui up ui",
    "docker:reg:video": "VIDEO=on docker compose run --rm e2e --project=foreign --grep \"REG-|INFRA-\""
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^26.6.2",
    "allure": "^3.18.0",
    "allure-js-commons": "^3.12.2",
    "allure-playwright": "^3.12.2",
    "eslint": "^10.11.0",
    "eslint-plugin-playwright": "^2.12.0",
    "qas-cli": "0.10.1",
    "typescript": "~6.0",
    "typescript-eslint": "^8.70.1"
  }
}
